# ================================================================
# DROPS PARTNERS — Environment Variables
# Copy this to .env.local and fill in real values
# ================================================================

# ── Supabase ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://partners.drops.agency

# ── Conversion Webhook ────────────────────────────────────────────
# Advertisers send conversions with this key in the x-api-key header
CONVERSION_API_KEY=your-secret-api-key-here

# ── Telegram Bot ─────────────────────────────────────────────────
# Get from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff
TELEGRAM_ADMIN_CHAT_ID=123456789
# Optional: set in Telegram webhook to prevent spoofing
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-here

# ── Cron ─────────────────────────────────────────────────────────
# Secret sent in x-cron-secret header to /api/cron/release-holds
# Set the same value in your Vercel Cron / external scheduler
CRON_SECRET=your-cron-secret-here

# ── Email (Resend) ────────────────────────────────────────────────
# Used for transactional emails (optional in MVP)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=noreply@drops.agency
